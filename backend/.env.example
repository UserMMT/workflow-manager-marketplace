PORT=3030
API_PREFIX=api
DB_DATABASE=./marketplace.sqlite

# Secret utilisé pour hasher les clés API des instances éditrices (HMAC) —
# distinct de tout secret d'un back_autohier/back_php particulier, ce
# marketplace est un service à part, partagé par toutes les instances.
PUBLISHER_KEY_PEPPER=change-this-in-production

# Secret utilisé pour hasher les jetons de session des comptes admin/collaborator/maintainer.
SESSION_TOKEN_PEPPER=change-this-in-production

FRONTEND_URL=http://localhost:3031
