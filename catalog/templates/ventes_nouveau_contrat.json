{
    "code": "ventes_nouveau_contrat",
    "name": "Nouveau contrat client",
    "description": "Ventes (mode single) : validation manager, avec boucle de correction.",
    "category": "Ventes",
    "itemType": "template",
    "version": "1.0.0",
    "content": {
        "code": "ventes_nouveau_contrat",
        "name": "Nouveau contrat client",
        "start_step": "approve",
        "steps": [
            {
                "id": "approve",
                "type": "approval",
                "mode": "single",
                "assignees": [
                    {
                        "type": "role",
                        "value": "MANAGER"
                    }
                ],
                "transitions": {
                    "approved": "ok",
                    "rejected": "ko",
                    "changes_requested": "fix"
                }
            },
            {
                "id": "fix",
                "type": "correction",
                "assignees": [
                    {
                        "type": "requester"
                    }
                ],
                "correction_policy": {
                    "resume_strategy": "same_rejecting_step"
                },
                "transitions": {
                    "resubmitted": "$resume"
                }
            },
            {
                "id": "ok",
                "type": "end",
                "final_status": "approved"
            },
            {
                "id": "ko",
                "type": "end",
                "final_status": "rejected"
            }
        ]
    }
}
